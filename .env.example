# ==============================================================================
# Environment Configuration Template for AI-QA-Suite
# ==============================================================================
# Copy this file to .env and adjust variables as required.
# NEVER commit your real .env file containing API keys or private secrets!

# Environment
ENVIRONMENT=local

# Base URLs
BASE_URL=https://the-internet.herokuapp.com
API_BASE_URL=https://jsonplaceholder.typicode.com

# Browser / UI Automation Settings
BROWSER=chromium
HEADLESS=true
TIMEOUT=15000
SLOW_MO=0

# AI Provider Settings
# Options: "mock" (default, free, 100% local, no API key needed), "llm" (external OpenAI/compatible provider)
AI_PROVIDER=mock

# External LLM Configuration (Only used when AI_PROVIDER=llm)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.2

# Logging & Reporting Settings
LOG_LEVEL=INFO
SCREENSHOT_ON_FAILURE=true
